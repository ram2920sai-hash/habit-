# Copy to .env for local use. On a website host, set these as private environment variables.
NEXO_HTTPS=0
NEXO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: set this to your exact HTTPS origin, without a trailing slash.
# NEXO_PUBLIC_ORIGIN=https://nexo.example.com
# Production: use a mounted persistent directory, e.g. /app/data.
# NEXO_DATA_DIR=/app/data

# Required for real password reset emails. Obtain settings from your mail provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# For implicit TLS, use SMTP_SECURITY=ssl and SMTP_PORT=465.
# Use an app password or SMTP key when your provider requires one.

# Render Free requires PostgreSQL: copy the pooled Neon/Supabase database URL here.
# Never put this URL in GitHub; it contains a database password.
DATABASE_URL=
# Render Free uses the HTTPS email API instead of SMTP.
BREVO_API_KEY=
EMAIL_FROM=
